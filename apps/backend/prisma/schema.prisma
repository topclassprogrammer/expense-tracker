generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  RUB
  USD
  EUR
  GBP
  KZT
  BYN
  UAH
}

/// Направление операции: поступление или трата.
enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  defaultCurrency Currency @default(RUB)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens RefreshToken[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]

  @@map("users")
}

/// Хранится только хеш refresh-токена; ротация — при каждом обновлении пары.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// userId = null — системная категория, общая для всех пользователей.
model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("circle-ellipsis")
  color     String   @default("#64748b")
  isDefault Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

/// Операция пользователя: доход или расход по категории.
model Transaction {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType @default(EXPENSE)
  currency    Currency        @default(RUB)
  date        DateTime        @db.Date
  description String?         @db.VarChar(500)
  categoryId  String
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, type, date])
  @@map("transactions")
}

/// Лимит на период "YYYY-MM"; categoryId = null — общий бюджет месяца.
model Budget {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  currency   Currency @default(RUB)
  period     String   @db.VarChar(7)
  categoryId String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@index([userId, period])
  @@map("budgets")
}
