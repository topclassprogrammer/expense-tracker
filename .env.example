# ─── PostgreSQL (docker-compose) ─────────────────────────────────────────────
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense_dev_password
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432

# ─── Backend (apps/backend) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://expense:expense_dev_password@localhost:5432/expense_tracker?schema=public
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Секреты: сгенерировать через `openssl rand -base64 48`
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# ─── Frontend (apps/frontend) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
